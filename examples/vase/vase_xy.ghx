                    <item name="CodeInput" type_name="gh_string" type_code="10">import clr
import System.IO
import os

# Add references
clr.AddReference("GH_IO")


from GH_IO.Serialization import GH_LooseChunk
import Grasshopper.Kernel.Types as gh_types

# Initialize output
status = None

# Get directory of the current GH document
gh_doc = ghenv.Component.OnPingDocument()
gh_path = gh_doc.FilePath

if not gh_path:
    status = "Save the Grasshopper file first."
else:
    try:
        gh_dir = os.path.dirname(gh_path)
        file_path = os.path.join(gh_dir, "mesh_output.xml")

        # Wrap mesh in GH_Mesh
        gh_mesh = gh_types.GH_Mesh(mesh)

        # Create and write to chunk
        chunk = GH_LooseChunk("Mesh")
        gh_mesh.Write(chunk)

        # Serialize to XML
        xml = chunk.Serialize_Xml()

        # Save to file
        System.IO.File.WriteAllText(file_path, xml)

        status = "Mesh saved to: \n" + file_path

    except Exception as e:
        status = "Error: " + str(e)


ghenv.Component.Message=status</item>
