                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
"""
# flake8: noqa
from Grasshopper.Kernel.GH_RuntimeMessageLevel import Warning


datamodule_settings = {
    'input_feature_names':   x_names or None, #default: DP
    'output_feature_names':  y_names or None, #default: PA
    'batch_size':       batch_size or 64,
}

model_settings = {

    'layer_widths': layer_widths or [128,128,128],
    'latent_dim':   latent_dim or 20,
    'topk':        top_k or 3,

}

if top_k &gt;=latent_dim:
    ghenv.Component.AddRuntimeMessage(Warning, "Check input values: `top_k` should be less than `latent_dim`.")


class SAE_wrapper():
    def __init__(self,datamodule_settings, model_settings):
        self.model_type = 'sparse_autoencoder'
        self.datamodule_settings = datamodule_settings
        self.model_settings = model_settings
        
    def __repr__(self):
        return "SparseAutoEncoder settings"

SAE = SAE_wrapper(datamodule_settings, model_settings)
