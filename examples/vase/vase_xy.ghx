                    <item name="CodeInput" type_name="gh_string" type_code="10">"""

"""
# flake8: noqa
from scriptcontext import sticky as st
import Rhino.Geometry as rg

from aixd_ara.gh_ui import embed_all
from aixd_ara.gh_ui_helper import component_id
from aixd_ara.gh_ui_helper import session_id

from Grasshopper.Kernel.GH_RuntimeMessageLevel import Warning, Error

cid = component_id(session_id(), ghenv.Component, "Embed")



if _embed:
    st[cid] = embed_all(session_id())


if cid in st.keys():
    ghenv.Component.Message = st[cid]["msg"]
    uids = st[cid]["res"]["uids"]
    vecs = st[cid]["res"]["embvecs"]
    
    # reformat into Rhino vectors:
    dim = len(vecs[0])
    if dim==2:
        vecs = [rg.Point3d(x,y,0) for x,y in vecs]
    elif dim==3:
        vecs = [rg.Point3d(x,y,z) for x,y,z in vecs]
    else:
        #ghenv.Component.Message = st[cid]["msg"]
        ghenv.Component.AddRuntimeMessage(Error, "Embedding is {}-dimensional. Should be 2D or 3D.".format(dim))</item>
