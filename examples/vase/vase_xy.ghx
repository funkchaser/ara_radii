                    <item name="CodeInput" type_name="gh_string" type_code="10">"""

"""
# flake8: noqa
from scriptcontext import sticky as st
from aixd_ara.gh_ui import project_setup_info
from aixd_ara.gh_ui import embeddings_setup_and_train
from aixd_ara.gh_ui_helper import component_id
from aixd_ara.gh_ui_helper import session_id

cid = component_id(session_id(), ghenv.Component, "EmbeddingTrain")


training_settings = {
    'max_epochs':   max_epochs or 10,
    'flag_wandb': True if wb is not None else False,
    'wandb_entity': wb
    }

settings = {
    'model_type':embedding_setup.model_type,
    'datamodule_settings':embedding_setup.datamodule_settings,
    'model_settings': embedding_setup.model_settings,
    'training_settings': training_settings
    }

if _train:
    if wb:
        import webbrowser
        projectname = project_setup_info(session_id())["project_name"]
        print(projectname)
        url = "https://wandb.ai/{}/{}".format(wb, projectname)
        webbrowser.open(url)
    
    ghenv.Component.Message = ""
    st[cid] = embeddings_setup_and_train(session_id(), settings)



if cid in st.keys():
    ghenv.Component.Message = st[cid]["msg"]
