              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">
import System
import os
import Grasshopper

gh_doc = ghenv.Component.OnPingDocument()
gh_path = os.path.dirname(gh_doc.FilePath)

file_path = os.path.join(gh_path,'meshes','mesh.bytes')

try:
    # Serialize mesh to byte array
    byte_array = Grasshopper.Kernel.GH_Convert.CommonObjectToByteArray(mesh)

    # Write to binary file
    System.IO.File.WriteAllBytes(file_path, byte_array)

    status = "Mesh serialized and saved to: ",file_path
except Exception as e:
    status = "Error: " + str(e)


print(status)</item>
