                    <item name="CodeInput" type_name="gh_string" type_code="10">import clr
import System
import System.IO
import Grasshopper
from Rhino.Geometry import Mesh

# Outputs
mesh = None
status = None

if not file_path or not System.IO.File.Exists(file_path):
    status = "File not found"
else:
    try:
        # Read byte array from file
        byte_array = System.IO.File.ReadAllBytes(file_path)

        # Deserialize to object
        #mesh = Grasshopper.Kernel.GH_Convert.ByteArrayToCommonObject(byte_array)
        mesh = Grasshopper.Kernel.GH_Convert.ByteArrayToCommonObject[Mesh](byte_array)

        if isinstance(mesh, Mesh):

            status = "Mesh deserialized successfully"
        else:
            status = "File did not contain a Mesh object"
    except Exception as e:
        status = "Error: " + str(e)

print(status)</item>
