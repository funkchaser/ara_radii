                    <item name="CodeInput" type_name="gh_string" type_code="10">import clr
import System.IO

# Add references
clr.AddReference("GH_IO")


from GH_IO.Serialization import GH_LooseChunk
import Grasshopper.Kernel.Types as gh_types

# Initialize outputs
status = None
mesh = None

if not file_path or not System.IO.File.Exists(file_path):
    status = "File not found"
else:
    try:
        # Read XML string from file
        xml_string = System.IO.File.ReadAllText(file_path)

        # Load chunk from XML
        chunk = GH_LooseChunk("Mesh")
        chunk.Deserialize_Xml(xml_string)

        # Deserialize GH_Mesh
        gh_mesh = gh_types.GH_Mesh()
        if gh_mesh.Read(chunk):
            mesh = gh_mesh.Value
            status = "Mesh loaded successfully"
        else:
            status = "Failed to read mesh from XML"

    except Exception as e:
        status = "Error: " + str(e)
