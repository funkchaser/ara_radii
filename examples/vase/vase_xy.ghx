              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import Rhino.Geometry as rg

if radius is not None: 
    x = [[v,uid] for v,uid in zip(embvecs,uids) if point.DistanceTo(v) &lt;=radius]
    uids_ = [u for v,u in x]
    embvecs_ = [v for v,u in x]
    
elif count is not None:
    dist = [point.DistanceTo(v) for v in embvecs]
    
    x = zip(dist, range(len(dist)))
    x.sort(key = lambda i: i[0])
    
    idx = [u for d,u in x[:count]]

    uids_ = [uids[i] for i in idx]
    embvecs_ = [embvecs[i] for i in idx] 
else:
    pass</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
