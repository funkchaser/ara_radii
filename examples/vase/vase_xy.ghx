                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
"""
# flake8: noqa
from Grasshopper.Kernel.GH_RuntimeMessageLevel import Warning


datamodule_settings = {
    'input_feature_names':   x_names or None, #default: DP
    'output_feature_names':  y_names or None, #default: PA
    'batch_size':       batch_size or 64,
}

model_settings = {

    'layer_widths': layer_widths or [128,128,128],
    'latent_dim':   latent_dim or 3, # should be 2 or 3 if no projection is used
}

if latent_dim &gt;3 or latent_dim&lt;2:
    ghenv.Component.AddRuntimeMessage(Warning, "Check input values: `latent_dim` should be 2 or 3 if no other projection is used.")


class AE_wrapper():
    def __init__(self,datamodule_settings, model_settings):
        self.model_type = 'autoencoder'
        self.datamodule_settings = datamodule_settings
        self.model_settings = model_settings
        
    def __repr__(self):
        return "AutoEncoder settings"

AE = AE_wrapper(datamodule_settings, model_settings)
