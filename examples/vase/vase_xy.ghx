"""
# flake8: noqa
from Grasshopper.Kernel.GH_RuntimeMessageLevel import Warning


temperature = temperature or 0.1 #TODO: what's the range?
reduction = reduction or 'mean' #['none', 'sum', 'mean']
negative_mode = negative_mode or 'unpaied' # 'paired' or 'unpaired'


if temperature &lt; 0:
    ghenv.Component.AddRuntimeMessage(Warning, "Check input values: `temperatures` should be &gt; 0")


class InfoNCE_wrapper():
    def __init__(self,temperature, reduction, negative_mode):
        self.dict = {'temperature':temperature,
                     'reduction': reduction,
                     'negative_mode':negative_mode}
    def __repr__(self):
        return "InfoNCE settings"



InfoNCE = InfoNCE_wrapper(temperature, reduction, negative_mode)</item>
