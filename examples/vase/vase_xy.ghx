                    <item name="CodeInput" type_name="gh_string" type_code="10">"""Loads an existing, pre-traind embedding model from a checkpoint. 
Requires a dataset to be loaded."""
# flake8: noqa
from scriptcontext import sticky as st

from aixd_ara.gh_ui import embedding_model_load
from aixd_ara.gh_ui_helper import component_id
from aixd_ara.gh_ui_helper import session_id

cid = component_id(session_id(), ghenv.Component, "EmbeddingModelLoad")

if not checkpoint_path:
    checkpoint_path = ""
if not checkpoint_name:
    checkpoint_name = "last"

if load:
    st[cid] = embedding_model_load(session_id(), checkpoint_name, checkpoint_path)

if cid in st.keys():
    msg = st[cid]["msg"]
