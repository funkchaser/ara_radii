                    <item name="CodeInput" type_name="gh_string" type_code="10">import os

from aixd_ara.gh_ui_helper import bytes2mesh
import Rhino.Geometry as rg

meshes = []
if uids and emb_xyz:
    for uid,pt in zip(uids,emb_xyz):
        mesh_file =os.path.join(path,"meshes","mesh_{:04d}.bytes".format(uid))
        
        mesh = bytes2mesh(mesh_file)
        
        transform = rg.Transform.Scale(rg.Plane.WorldXY,scale, scale, scale)
        mesh.Transform(transform)
        
        transform = rg.Transform.Translation(pt.X, pt.Y, pt.Z)
        mesh.Transform(transform)
        
        meshes.append(mesh)
    </item>
